@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #2563EB
skinparam ActivityBorderColor #0F172A
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityFontColor #0F172A

title MLOpsFull Model Lifecycle

start
:CSV datasets\nprojects, tags, dataset, holdout;
:data.py\nload, clean, stratified split, tokenize;
:models.py\nSciBERT + dropout + classifier;
:train.py\nRay Train workload;
:MLflow/Ray checkpoint\nparams, metrics, model.pt, args.json;
:evaluate.py\noverall, per-class, slice metrics;
if (quality gate passes?) then (yes)
  :predict.py\nload best checkpoint;
  :serve.py\nFastAPI prediction API;
  :monitoring_metrics.py\nPrometheus metrics;
else (no)
  :Review data, config,\nor training strategy;
endif
stop
@enduml
