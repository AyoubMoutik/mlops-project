@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #2563EB
skinparam ActivityBorderColor #0F172A
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityFontColor #0F172A
skinparam NoteBackgroundColor #FFFBEB
skinparam NoteBorderColor #D97706

title Dockerized Jenkins CI/CD Pipeline

start
:Checkout source code;
:Resolve Git branch;
:Build Docker image\nayoubmoutik/mlopsfull:<BUILD_NUMBER>;
:Run CI checks\ncompileall, pytest, flake8 critical rules;
:Train model in container\nRay Train + MLflow;
:Save run_id and training artifacts;
:Evaluate on holdout.csv;
if (Weighted F1 >= MIN_F1?) then (yes)
  :Push build and latest tags\nto Docker Hub;
  if (DEPLOY=true and branch=master?) then (yes)
    :Start model API container\nFastAPI backend on port 8000;
    :Smoke test /\n/predict/\n/metrics;
    :Archive deployment artifacts;
  else (no)
    :Skip deployment;
  endif
else (no)
  :Fail pipeline before publish/deploy;
endif
:Archive logs and JSON/TXT artifacts;
stop
@enduml
