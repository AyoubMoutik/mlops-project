@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam componentStyle rectangle
skinparam roundcorner 8
skinparam ArrowColor #0D9488
skinparam ComponentBorderColor #0F172A
skinparam ComponentBackgroundColor #F8FAFC
skinparam DatabaseBorderColor #0F172A
skinparam DatabaseBackgroundColor #ECFEFF
skinparam NodeBorderColor #0F172A
skinparam NodeBackgroundColor #EFF6FF

title Local Monitoring Architecture

node "Docker Compose Network" {
  component "Jenkins\nmlops-jenkins" as Jenkins
  component "Model API\nmlopsfull-serve\nFastAPI + loaded checkpoint" as API
  component "Prometheus\nmlops-prometheus" as Prom
  component "Grafana\nmlops-grafana" as Grafana
  database "Docker volume\nmlopsfull_storage\nMLflow + Ray artifacts" as Volume
}

actor "User / smoke tests" as User

Jenkins --> API : deploys container\nwith RUN_ID
API --> Volume : loads checkpoint\nand model metadata
User --> API : GET /\nPOST /predict/\nGET /metrics
API --> API : record request,\nlatency, class,\nconfidence, input length
Prom --> API : scrape /metrics
Grafana --> Prom : query dashboards
@enduml
